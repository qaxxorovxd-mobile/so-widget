<?xml version="1.0" encoding="utf-8"?>
<!-- Native media widget: one bitmap + three independent tap areas positioned from code via padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/np_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/so_widget_desc"
        android:scaleType="fitXY" />

    <!-- Edge taps: left = previous, right = next (for designs without skip buttons). -->
    <FrameLayout
        android:id="@+id/np_c_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/np_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Previous" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/np_c_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/np_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Next" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/np_c_prev"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/np_prev"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Previous" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/np_c_toggle"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/np_toggle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Play or pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/np_c_next"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/np_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Next" />
    </FrameLayout>
</FrameLayout>
