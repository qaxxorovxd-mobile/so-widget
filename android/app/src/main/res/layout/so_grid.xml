<?xml version="1.0" encoding="utf-8"?>
<!-- Native device widget: one bitmap + up to 9 tap zones positioned from code via padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/g_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/g_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/so_widget_desc"
        android:scaleType="fitXY" />

    <FrameLayout android:id="@+id/g_c0" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b0" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c1" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b1" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c2" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b2" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c3" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b3" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c4" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b4" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c5" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b5" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c6" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b6" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c7" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b7" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout android:id="@+id/g_c8" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <FrameLayout android:id="@+id/g_b8" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
